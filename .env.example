# =============================================================================
# GYM CMS — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.
# =============================================================================

# ── Database (Turso / LibSQL) ─────────────────────────────────────────────────
# Create a free database at https://turso.tech
# Format: libsql://<database-name>-<org>.turso.io
TURSO_DATABASE_URL=libsql://your-database-name.turso.io

# Turso auth token — found in Turso dashboard > Database > Generate Token
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── Authentication ────────────────────────────────────────────────────────────
# A strong random secret for signing JWT session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-strong-random-secret-at-least-32-chars
